{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 420,
  "height": 280,

  "padding": {
    "left": 70,
    "right": 70,
    "top": 10,
    "bottom": 25
  },

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 470
  },

  "layer": [

    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [

        {
          "calculate": "datum.properties.STATE_NAME",
          "as": "state_name"
        },

        {
          "lookup": "state_name",

          "from": {
            "data": {
              "url": "data/afl_clubs_by_state.csv"
            },

            "key": "state",

            "fields": ["clubs", "club_list"]
          },

          "default": 0
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },

      "encoding": {

        "color": {
          "field": "clubs",
          "type": "quantitative",

          "scale": {
            "type": "threshold",
            "domain": [1, 3],

            "range": [
              "#e0e0e0",
              "#a5d6a7",
              "#1b5e20"
            ]
          },

          "legend": {
            "title": "Clubs",
            "orient": "none",
            "legendX": 430,
            "legendY": 105,
            "titleFontSize": 15,
            "labelFontSize": 13,
            "gradientLength": 120
          }
        },

        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },

          {
            "field": "clubs",
            "title": "AFL Clubs"
          },

          {
            "field": "club_list",
            "title": "Teams"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/afl_venues.csv"
      },

      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "color": "#e76f51",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },

      "encoding": {

        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "capacity",
          "type": "quantitative",

          "scale": {
            "range": [50, 650]
          },

          "legend": {
            "title": "Capacity",
            "orient": "none",
            "legendX": -50,
            "legendY": 110,
            "titleFontSize": 15,
            "labelFontSize": 13
          }
        },

        "tooltip": [
          {
            "field": "venue",
            "title": "Stadium"
          },

          {
            "field": "state",
            "title": "State"
          },

          {
            "field": "capacity",
            "title": "Capacity",
            "format": ","
          }
        ]
      }
    }

  ],

  "title": {
    "text": "AFL CLUB DISTRIBUTION BY STATE",
    "anchor": "middle",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#666666",
    "offset": 18
  },

  "config": {

    "background": "#f5f5f5",

    "view": {
      "stroke": null
    },

    "legend": {
      "symbolType": "circle"
    }
  }
}